{
  "manifest_version": 3,
  "name": "TermsAnalyzer",
  "version": "1.0.0",
  "description": "Instantly analyze Terms of Service and Privacy Policies for unfair clauses using AI",
  "permissions": [
    "tabs",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "action": {},
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
